# LLM API key (required) — works with any LiteLLM-supported provider
# OpenAI:    LLM_API_KEY=sk-...
# Anthropic: LLM_API_KEY=sk-ant-...
# Gemini:    LLM_API_KEY=AIza...
# DeepSeek:  LLM_API_KEY=sk-...
LLM_API_KEY=your-key-here

# Optional base URL override for OpenAI-compatible gateways
# OPENAI_API_BASE=https://api.deepseek.com

# --- REST API server variables (read by `ultrakb-api` / `python -m ultrakb.api`) ---
# ULTRAKB_API_TOKEN=...   # required bearer token clients send as Authorization: Bearer <token>
# ULTRAKB_KB_ROOT=...     # optional; where REST /init creates KBs (default: ~/.config/ultrakb/kbs)
